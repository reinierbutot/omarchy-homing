        id="edge",
        label="Microsoft Edge",
        class_re=re.compile(r"^(microsoft-edge(-stable)?)$", re.I),
        class_regex=r"^([Mm]icrosoft-edge(-stable)?)$",
        classes=("microsoft-edge", "Microsoft-edge", "microsoft-edge-stable"),
