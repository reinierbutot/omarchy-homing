#!/usr/bin/python3
"""Home the focused app to a Hyprland workspace.

Homing is an Omarchy plugin. The interactive flow uses omarchy-menu-select
and omarchy-menu-input (omarchy-shell overlays), then writes a generated
Lua module that Hyprland loads from ~/.config/hypr/homing.lua.

Chromium-based browsers share one window class across profiles, so profile
assignments are applied by tagging the window from /proc before window
rules run.
"""

from __future__ import annotations

import errno
import fcntl
import json
import os
import re
import signal
import stat
import subprocess
import sys
import threading
from dataclasses import dataclass
from pathlib import Path
from typing import Any

PLUGIN_ID = "reinier.homing"
ASSIGNMENTS_VERSION = 1
NUMERIC_WORKSPACES = list(range(1, 11))
RE2_SPECIAL = set(r"\.^$|()[]{}*+?")
WORKSPACE_RE = re.compile(r"^(?:\d+|special:[A-Za-z0-9_-]+|name:[A-Za-z0-9_-]+|[A-Za-z0-9_-]+)$")

ICON_HOME = "󰋜"
ICON_APP = ""
ICON_BROWSER = ""
ICON_PROFILE = ""
ICON_EDIT = ""
ICON_STOP = ""
ICON_WARN = ""
ICON_OK = ""

MAX_TEXT_FILE_BYTES = 2 * 1024 * 1024
MAX_LOCAL_STATE_BYTES = 8 * 1024 * 1024
MAX_SUBPROCESS_OUTPUT = 1 * 1024 * 1024
HYPRCTL_TIMEOUT = 8.0
HYPRCTL_RELOAD_TIMEOUT = 15.0
MENU_TIMEOUT = 600.0
NOTIFY_TIMEOUT = 5.0
READ_FLAGS = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK
EXCL_WRITE_FLAGS = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC


@dataclass(frozen=True)
class Paths:
    home: Path
    assignments: Path
    lua: Path
    hyprland_lua: Path

    @classmethod
    def from_home(cls, home: Path | None = None) -> Paths:
        home = Path(home) if home is not None else Path.home()
        config = Path(os.environ.get("XDG_CONFIG_HOME", home / ".config"))
        return cls(
            home=home,
            assignments=config / "omarchy" / "homing" / "assignments.json",
            lua=config / "hypr" / "homing.lua",
            hyprland_lua=config / "hypr" / "hyprland.lua",
        )


@dataclass(frozen=True)
class BrowserFamily:
    id: str
    label: str
    class_re: re.Pattern[str]
    class_regex: str
    classes: tuple[str, ...]
    user_data_dir: Path


BROWSER_FAMILIES = (
    BrowserFamily(
        id="chromium",
        label="Chromium",
        class_re=re.compile(r"^(chromium|chromium-browser)$", re.I),
        class_regex=r"^([Cc]hromium(-browser)?)$",
        classes=("chromium", "Chromium", "chromium-browser", "Chromium-browser"),
        user_data_dir=Path.home() / ".config" / "chromium",
    ),
    BrowserFamily(
        id="chrome",
        label="Google Chrome",
        class_re=re.compile(r"^(google-chrome(-stable)?)$", re.I),
        class_regex=r"^([Gg]oogle-chrome(-stable)?)$",
        classes=("google-chrome", "Google-chrome", "google-chrome-stable"),
        user_data_dir=Path.home() / ".config" / "google-chrome",
    ),
    BrowserFamily(
        id="brave",
        label="Brave",
        class_re=re.compile(r"^(brave-browser|brave)$", re.I),
        class_regex=r"^([Bb]rave(-browser)?)$",
        classes=("brave-browser", "Brave-browser", "brave", "Brave"),
        user_data_dir=Path.home() / ".config" / "BraveSoftware" / "Brave-Browser",
