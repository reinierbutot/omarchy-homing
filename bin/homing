@dataclass
class Window:
    address: str
    class_name: str
    initial_class: str
    title: str
    pid: int | None
    workspace: str


@dataclass
class BrowserProfile:
    directory: str
    name: str
    user_data_dir: Path


def family_for_class(class_name: str) -> BrowserFamily | None:
    for family in BROWSER_FAMILIES:
        if family.class_re.match(class_name or ""):
            return family
    return None


def re2_escape(value: str) -> str:
    return "".join("\\" + ch if ch in RE2_SPECIAL else ch for ch in value)


def class_regex_for(class_name: str) -> str:
    family = family_for_class(class_name)
    if family:
        return family.class_regex
    return f"^({re2_escape(class_name)})$"


def lua_string(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def assignment_id(kind: str, class_name: str, profile_directory: str | None = None) -> str:
    family = family_for_class(class_name)
    family_id = family.id if family else class_name
    if kind == "profile":
        return f"profile:{family_id}:{profile_directory}"
    return f"class:{family_id}"


def tag_for_profile(class_name: str, profile_directory: str) -> str:
    family = family_for_class(class_name)
    family_id = family.id if family else slug(class_name)
    return f"homing-{family_id}-{slug(profile_directory)}"


def slug(value: str) -> str:
    text = re.sub(r"[^A-Za-z0-9]+", "-", value.strip().lower()).strip("-")
    return text or "profile"


def read_cmdline(pid: int) -> str:
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return ""
    if raw.count(b"\0") > 1:
        return raw.replace(b"\0", b"\n").decode("utf-8", "replace")
    return raw.replace(b"\0", b" ").decode("utf-8", "replace").strip()


def parse_flag(cmdline: str, flag: str) -> str | None:
    if not cmdline:
        return None
    joined = cmdline.replace("\n", " ")
    match = re.search(rf"{re.escape(flag)}=([^\n]+)", cmdline)
    if match:
        value = match.group(1).strip()
        cut = re.search(r"\s+--", value)
        if cut:
            value = value[: cut.start()].strip()
        return value or None
    match = re.search(rf"{re.escape(flag)}(?:\n|\s+)(\S+(?: \S+?)?)", cmdline)
    if match:
        return match.group(1).strip() or None
    match = re.search(rf"{re.escape(flag)}=(\S+(?: \d+)?)", joined)
    if match:
        return match.group(1).strip() or None
    return None


def iter_pid_chain(pid: int, limit: int = 8) -> list[int]:
    chain: list[int] = []
    current = pid
    seen: set[int] = set()
    while current and current > 1 and current not in seen and len(chain) < limit:
        seen.add(current)
        chain.append(current)
        try:
            status = Path(f"/proc/{current}/status").read_text(errors="replace")
        except OSError:
            break
        match = re.search(r"^PPid:\s*(\d+)", status, re.M)
        current = int(match.group(1)) if match else 0
    return chain


def proc_text(pid: int, name: str) -> str:
    try:
        return Path(f"/proc/{pid}/{name}").read_text(errors="replace")
    except OSError:
        return ""


def fd_paths(pid: int) -> list[str]:
    directory = Path(f"/proc/{pid}/fd")
    if not directory.is_dir():
        return []
    paths: list[str] = []
    try:
        entries = list(directory.iterdir())
    except OSError:
        return []
    for entry in entries:
        try:
            paths.append(str(entry.readlink()))
        except OSError:
            continue
    return paths


def _lstat(path: Path) -> os.stat_result | None:
    try:
        return os.lstat(path)
    except OSError:
        return None


def _close_fd(fd: int) -> None:
    if fd >= 0:
        try:
            os.close(fd)
        except OSError:
            pass


def _drop_nonblock(fd: int) -> None:
    try:
        flags = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, flags & ~os.O_NONBLOCK)
    except OSError:
        pass


def _fsync_dir(directory: Path) -> None:
    try:
        dir_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    except OSError:
        return
    try:
        os.fsync(dir_fd)
    except OSError:
        pass
    finally:
        _close_fd(dir_fd)


def _open_regular(path: Path, flags: int) -> tuple[int, os.stat_result]:
    fd = os.open(path, flags)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise OSError(errno.EINVAL, f"not a regular file: {path}")
        _drop_nonblock(fd)
        opened = fd
        fd = -1
        return opened, info
    finally:
        _close_fd(fd)


def read_regular_file(path: Path, *, max_bytes: int) -> str | None:
    """Read a regular file without following the last path component or blocking on FIFOs."""
    try:
        fd, info = _open_regular(path, READ_FLAGS)
    except OSError:
        return None
    try:
        if info.st_size > max_bytes:
            return None
        chunks: list[bytes] = []
        remaining = max_bytes + 1
        while remaining > 0:
            block = os.read(fd, remaining)
            if not block:
                break
            chunks.append(block)
            remaining -= len(block)
        data = b"".join(chunks)
        if len(data) > max_bytes:
            return None
        return data.decode("utf-8")
    except (OSError, UnicodeDecodeError):
        return None
    finally:
        _close_fd(fd)


def _replace_mode(path: Path) -> int:
    info = _lstat(path)
    if info is not None and stat.S_ISREG(info.st_mode):
        return stat.S_IMODE(info.st_mode)
    return 0o644


def _exclusive_tmp(directory: Path, name: str) -> tuple[int, str]:
    flags = os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC
    last_error: OSError | None = None
    for _ in range(64):
        tmp_path = directory / f".{name}.{os.urandom(8).hex()}.tmp"
        try:
            return os.open(tmp_path, flags, 0o600), str(tmp_path)
        except OSError as exc:
            last_error = exc
            if exc.errno != errno.EEXIST:
                raise
    raise OSError(errno.EEXIST, "could not create temporary file") from last_error


def exclusive_write(path: Path, text: str) -> None:
    data = text.encode("utf-8")
    fd = os.open(path, EXCL_WRITE_FLAGS, 0o644)
    try:
        written = 0
        while written < len(data):
            written += os.write(fd, data[written:])
        os.fsync(fd)
    except Exception:
        _close_fd(fd)
        fd = -1
        try:
            os.unlink(path)
        except OSError:
            pass
        raise
    _close_fd(fd)


def unlink_regular(path: Path) -> bool:
    info = _lstat(path)
    if info is None or not stat.S_ISREG(info.st_mode):
        return False
    try:
        os.unlink(path)
    except OSError:
        return False
    return True


def rmdir_if_empty(path: Path) -> bool:
    info = _lstat(path)
    if info is None or not stat.S_ISDIR(info.st_mode):
        return False
    try:
        os.rmdir(path)
    except OSError:
        return False
    return True


def _kill_process(proc: subprocess.Popen[bytes]) -> None:
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except OSError:
        try:
            proc.kill()
        except OSError:
            pass


def run_limited(
    args: list[str],
    *,
    timeout: float,
    max_output: int = MAX_SUBPROCESS_OUTPUT,
    input_text: str | None = None,
) -> subprocess.CompletedProcess[str] | None:
    """Run a subprocess with a deadline and a hard cap on captured output."""
    try:
        proc = subprocess.Popen(
            args,
            stdin=subprocess.PIPE if input_text is not None else subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            start_new_session=True,
        )
    except OSError:
        return None
    assert proc.stdout is not None and proc.stderr is not None
    chunks = {"out": bytearray(), "err": bytearray()}
    overflow = threading.Event()

    def pump(stream: Any, key: str) -> None:
        try:
            while True:
                block = stream.read(65536)
                if not block:
                    return
                buf = chunks[key]
                room = max_output - len(buf)
                if room <= 0 or len(block) > room:
                    if room > 0:
                        buf.extend(block[:room])
                    overflow.set()
                    _kill_process(proc)
                    return
                buf.extend(block)
        except (OSError, ValueError):
            return

    readers = [
        threading.Thread(target=pump, args=(proc.stdout, "out"), daemon=True),
        threading.Thread(target=pump, args=(proc.stderr, "err"), daemon=True),
    ]
    for reader in readers:
        reader.start()
    try:
        if input_text is not None and proc.stdin is not None:
            try:
                proc.stdin.write(input_text.encode("utf-8"))
            except OSError:
                pass
            try:
                proc.stdin.close()
            except OSError:
                pass
        try:
            proc.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            _kill_process(proc)
            try:
                proc.wait(timeout=1)
            except (subprocess.TimeoutExpired, OSError):
                pass
            return None
        if overflow.is_set() or proc.returncode is None:
            if proc.returncode is None:
                _kill_process(proc)
            return None
        return subprocess.CompletedProcess(
            args,
            proc.returncode,
            bytes(chunks["out"]).decode("utf-8", "replace"),
            bytes(chunks["err"]).decode("utf-8", "replace"),
        )
    finally:
        for stream in (proc.stdin, proc.stdout, proc.stderr):
            if stream is not None:
                try:
                    stream.close()
                except OSError:
                    pass
        for reader in readers:
            reader.join(timeout=1)


def profile_directories_from_local_state(user_data_dir: Path) -> dict[str, str]:
    names = {"Default": "Default", "Guest Profile": "Guest"}
    local_state = user_data_dir / "Local State"
    raw = read_regular_file(local_state, max_bytes=MAX_LOCAL_STATE_BYTES)
    if raw is None:
        return names
    try:
        data = json.loads(raw)
    except json.JSONDecodeError:
        return names
    cache = data.get("profile", {}).get("info_cache", {})
    if isinstance(cache, dict):
        for directory, info in cache.items():
            if not isinstance(directory, str) or directory == "System Profile":
                continue
            label = directory
            if isinstance(info, dict):
                label = str(info.get("name") or directory)
            names[directory] = label
    return names


def detect_user_data_dir(pid: int | None, family: BrowserFamily | None) -> Path | None:
    if pid:
        for candidate in iter_pid_chain(pid):
            cmdline = read_cmdline(candidate)
            explicit = parse_flag(cmdline, "--user-data-dir")
            if explicit:
                return Path(explicit).expanduser()
            maps = proc_text(candidate, "maps")
            fds = "\n".join(fd_paths(candidate))
            blob = maps + "\n" + fds
            if family and str(family.user_data_dir) in blob:
                return family.user_data_dir
            match = re.search(r"(/home/[^/\s]+/\.config/(?:chromium|google-chrome|BraveSoftware/Brave-Browser|microsoft-edge|vivaldi|net\.imput\.helium))", blob)
            if match:
                return Path(match.group(1))
    if family and family.user_data_dir.is_dir():
        return family.user_data_dir
    return None


def detect_profile_directory(pid: int | None, user_data_dir: Path | None) -> str | None:
    if not pid:
        return None
    known = list(profile_directories_from_local_state(user_data_dir).keys()) if user_data_dir else ["Default"]
    for candidate in iter_pid_chain(pid):
        cmdline = read_cmdline(candidate)
        flagged = parse_flag(cmdline, "--profile-directory")
        if flagged:
            return flagged
        blob = proc_text(candidate, "maps") + "\n" + "\n".join(fd_paths(candidate))
        if not user_data_dir:
            continue
        best: str | None = None
        best_len = -1
        root = str(user_data_dir)
        for directory in known:
            needle = f"{root}/{directory}/"
            if needle in blob and len(needle) > best_len:
                best = directory
                best_len = len(needle)
        if best:
            return best
    return None


def detect_browser_profile(window: Window) -> BrowserProfile | None:
    family = family_for_class(window.class_name)
    if not family:
        return None
    user_data_dir = detect_user_data_dir(window.pid, family)
    if user_data_dir is None:
        user_data_dir = family.user_data_dir
    directory = detect_profile_directory(window.pid, user_data_dir) or "Default"
    names = profile_directories_from_local_state(user_data_dir)
    return BrowserProfile(directory=directory, name=names.get(directory, directory), user_data_dir=user_data_dir)


def empty_store() -> dict[str, Any]:
    return {"version": ASSIGNMENTS_VERSION, "assignments": []}


def load_store(path: Path) -> dict[str, Any]:
    raw = read_regular_file(path, max_bytes=MAX_TEXT_FILE_BYTES)
    if raw is None:
        return empty_store()
    try:
        data = json.loads(raw)
    except json.JSONDecodeError:
        return empty_store()
    if not isinstance(data, dict):
        return empty_store()
    assignments = data.get("assignments")
    if not isinstance(assignments, list):
        data["assignments"] = []
    data["version"] = ASSIGNMENTS_VERSION
    return data


def upsert_assignment(store: dict[str, Any], assignment: dict[str, Any]) -> dict[str, Any]:
    rows = [row for row in store.get("assignments", []) if row.get("id") != assignment["id"]]
    rows.append(assignment)
    rows.sort(key=lambda row: (row.get("kind") != "class", str(row.get("id"))))
    store["assignments"] = rows
    return store


def remove_assignment(store: dict[str, Any], assignment_id_value: str) -> dict[str, Any]:
    store["assignments"] = [row for row in store.get("assignments", []) if row.get("id") != assignment_id_value]
    return store


def find_assignment(store: dict[str, Any], window: Window, profile: BrowserProfile | None = None) -> dict[str, Any] | None:
    rows = store.get("assignments", [])
    if profile:
        profile_id = assignment_id("profile", window.class_name, profile.directory)
        for row in rows:
            if row.get("id") == profile_id:
                return row
    class_id = assignment_id("class", window.class_name)
    family = family_for_class(window.class_name)
    for row in rows:
        if row.get("id") == class_id:
            return row
        if family and row.get("kind") == "class" and family_for_class(str(row.get("class") or "")) is family:
            return row
    return None


def backup_file(path: Path) -> None:
    text = read_regular_file(path, max_bytes=MAX_TEXT_FILE_BYTES)
    if text is None:
        return
    atomic_write(path.with_suffix(path.suffix + ".bak"), text)


def hyprland_hook_backup(path: Path) -> Path:
    return path.with_name(path.name + ".homing.bak")


def backup_hyprland_hook(path: Path) -> None:
    bak = hyprland_hook_backup(path)
    if _lstat(bak) is not None:
        return
    text = read_regular_file(path, max_bytes=MAX_TEXT_FILE_BYTES)
    if text is None:
        return
    try:
        exclusive_write(bak, text)
    except OSError:
        return


def atomic_write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    data = text.encode("utf-8")
    mode = _replace_mode(path)
    fd = -1
    tmp_name = ""
    try:
        fd, tmp_name = _exclusive_tmp(path.parent, path.name)
        os.fchmod(fd, mode)
        written = 0
        while written < len(data):
            written += os.write(fd, data[written:])
        os.fsync(fd)
        os.close(fd)
        fd = -1
        os.replace(tmp_name, path)
        tmp_name = ""
        _fsync_dir(path.parent)
    finally:
        _close_fd(fd)
        if tmp_name:
            try:
                os.unlink(tmp_name)
            except OSError:
                pass


def save_store(path: Path, store: dict[str, Any]) -> None:
    backup_file(path)
    atomic_write(path, json.dumps(store, indent=2, sort_keys=False) + "\n")


LUA_PROFILE_RUNTIME = r'''
local function homing_read(path)
  local file = io.open(path, "r")
  if not file then return nil end
  local data = file:read("*a")
  file:close()
  return data
end

local function homing_ppid(pid)
  local status = homing_read("/proc/" .. tostring(pid) .. "/status")
  if not status then return nil end
  return tonumber(status:match("PPid:%s*(%d+)"))
end

local function homing_profile_from_cmdline(text)
  if not text or text == "" then return nil end
  local dir = text:match("%-%-profile%-directory=([^\n]+)")
  if dir then
    local cut = dir:find(" %-%-", 1, true)
    if cut then dir = dir:sub(1, cut - 1) end
    dir = dir:match("^%s*(.-)%s*$")
    if dir and dir ~= "" then return dir end
  end
  dir = text:match("%-%-profile%-directory[\n ]+([^\n]+)")
  if dir then
    dir = dir:match("^(%S+(?: %d+)?)") or dir
    dir = dir:match("^%s*(.-)%s*$")
    if dir and dir ~= "" then return dir end
  end
  return nil
end

local function homing_detect_profile(pid, user_data_dir, profiles)
  local current = pid
  for _ = 1, 8 do
    if not current or current <= 1 then break end
    local cmdline = homing_read("/proc/" .. tostring(current) .. "/cmdline") or ""
    cmdline = cmdline:gsub("%z", "\n")
    local flagged = homing_profile_from_cmdline(cmdline)
    if flagged then return flagged end
    local maps = homing_read("/proc/" .. tostring(current) .. "/maps") or ""
    local best, best_len = nil, -1
    for _, profile in ipairs(profiles) do
      local needle = user_data_dir .. "/" .. profile.directory .. "/"
      if maps:find(needle, 1, true) and #needle > best_len then
        best = profile.directory
        best_len = #needle
      end
    end
    if best then return best end
    current = homing_ppid(current)
  end
  return nil
end

local function homing_class_matches(class_name, classes)
  local needle = string.lower(tostring(class_name or ""))
  for _, item in ipairs(classes) do
    if needle == string.lower(item) then return true end
  end
  return false
end
'''


def generate_lua(store: dict[str, Any]) -> str:
    assignments = store.get("assignments") or []
    lines = [
        "-- Homing autogenerated rules. Do not edit.",
        "-- Source of truth: ~/.config/omarchy/homing/assignments.json",
        "-- Rewrite with the Homing plugin (`homing pin` / `homing unpin`).",
        "",
    ]
    class_rows = [row for row in assignments if row.get("kind") == "class"]
    profile_rows = [row for row in assignments if row.get("kind") == "profile"]

    if not assignments:
        lines += ["-- No assignments yet.", "return true", ""]
        return "\n".join(lines)

    for row in class_rows:
        name = f"homing-class-{slug(str(row.get('class') or 'app'))}"
        regex = str(row.get("class_regex") or class_regex_for(str(row.get("class") or "")))
        workspace = str(row.get("workspace"))
        lines.append(
            "hl.window_rule({\n"
            f"  name = {lua_string(name)},\n"
            f"  match = {{ class = {lua_string(regex)} }},\n"
            f"  workspace = {lua_string(workspace)},\n"
            "})"
        )
        lines.append("")

    if profile_rows:
        families: dict[str, dict[str, Any]] = {}
        for row in profile_rows:
            class_name = str(row.get("class") or "")
            family = family_for_class(class_name)
            family_id = family.id if family else slug(class_name)
            bucket = families.setdefault(
                family_id,
                {
                    "classes": list(family.classes) if family else [class_name],
                    "user_data_dir": str(row.get("user_data_dir") or (family.user_data_dir if family else "")),
                    "profiles": [],
                },
            )
            bucket["profiles"].append(
                {
                    "directory": str(row.get("profile_directory") or "Default"),
                    "tag": str(row.get("tag") or tag_for_profile(class_name, str(row.get("profile_directory") or "Default"))),
                    "workspace": str(row.get("workspace")),
                }
            )

        lines.append(LUA_PROFILE_RUNTIME.rstrip())
        lines.append("")
        lines.append("local homing_browsers = {")

        for family_id, bucket in families.items():
            lines.append("  {")
            class_list = ", ".join(lua_string(item) for item in bucket["classes"])
            lines.append(f"    classes = {{ {class_list} }},")
            lines.append(f"    user_data_dir = {lua_string(bucket['user_data_dir'])},")
            lines.append("    profiles = {")
            for profile in bucket["profiles"]:
                lines.append(
                    "      { "
                    f"directory = {lua_string(profile['directory'])}, "
                    f"tag = {lua_string(profile['tag'])}, "
                    f"workspace = {lua_string(profile['workspace'])} "
                    "},"
                )
            lines.append("    },")
            lines.append("  },")
        lines += [
            "}",
            "",
            'hl.on("window.open_early", function(w)',
            "  if not w or not w.pid then return end",
            '  local class_name = w.class or w.initial_class or ""',
            "  for _, browser in ipairs(homing_browsers) do",
            "    if homing_class_matches(class_name, browser.classes) then",
            "      local directory = homing_detect_profile(w.pid, browser.user_data_dir, browser.profiles)",
            "      if directory then",
            "        for _, profile in ipairs(browser.profiles) do",
            "          if profile.directory == directory then",
            '            hl.dispatch(hl.dsp.window.tag({ tag = "+" .. profile.tag, window = w }))',
            "            if profile.workspace then",
            "              hl.dispatch(hl.dsp.window.move({ workspace = profile.workspace, window = w }))",
            "            end",
            "            return",
            "          end",
            "        end",
            "      end",
            "    end",
            "  end",
            "end)",
            "",
        ]

        for row in profile_rows:
            tag = str(row.get("tag") or tag_for_profile(str(row.get("class") or ""), str(row.get("profile_directory") or "Default")))
            workspace = str(row.get("workspace"))
            lines.append(
                "hl.window_rule({\n"
                f"  name = {lua_string(tag)},\n"
                f"  match = {{ tag = {lua_string(tag)} }},\n"
                f"  workspace = {lua_string(workspace)},\n"
                "})"
            )
            lines.append("")

    lines.append("return true")
    lines.append("")
    return "\n".join(lines)


HYPRLAND_HOOK = '-- Homing plugin: generated app → workspace assignments.\npcall(require, "hypr.homing")\n'
HYPRLAND_HOOK_COMMENT = "-- Homing plugin: generated app → workspace assignments."
HYPRLAND_HOOK_CALL = 'pcall(require, "hypr.homing")'


def hyprland_has_hook(text: str) -> bool:
    return "hypr.homing" in text


def inject_hyprland_hook(text: str) -> str:
    if hyprland_has_hook(text):
        return text
    hook = "\n" + HYPRLAND_HOOK
    marker = "-- Added by hyprmoncfg"
    if marker in text:
        return text.replace(marker, HYPRLAND_HOOK + "\n" + marker, 1)
    if text and not text.endswith("\n"):
        text += "\n"
    return text + hook


def remove_hyprland_hook(text: str) -> str:
    kept: list[str] = []
    for line in text.splitlines():
        stripped = line.strip()
        if stripped in {HYPRLAND_HOOK_COMMENT, HYPRLAND_HOOK_CALL}:
            continue
        kept.append(line)
    result = "\n".join(kept)
    if text.endswith("\n") or result:
        if not result.endswith("\n"):
            result += "\n"
    while "\n\n\n" in result:
        result = result.replace("\n\n\n", "\n\n")
    return result


def ensure_hyprland_hook(path: Path) -> bool:
    original = read_regular_file(path, max_bytes=MAX_TEXT_FILE_BYTES)
    if original is None:
        return False
    updated = inject_hyprland_hook(original)
    if updated == original:
        return False
    backup_hyprland_hook(path)
    atomic_write(path, updated)
    return True


def write_lua(paths: Paths, store: dict[str, Any]) -> None:
    backup_file(paths.lua)
    atomic_write(paths.lua, generate_lua(store))


def maybe_install_hyprland_hook(paths: Paths, store: dict[str, Any], *, force: bool = False) -> dict[str, Any]:
    """Ask before touching hyprland.lua. Never writes that file unless the user picks Yes."""
    current = read_regular_file(paths.hyprland_lua, max_bytes=MAX_TEXT_FILE_BYTES)
    if current is None:
        if _lstat(paths.hyprland_lua) is None:
            store["hyprlandHook"] = "missing-config"
            notify(
                "Homing",
                f"No {paths.hyprland_lua} to hook. Add {HYPRLAND_HOOK_CALL} yourself if you use Hyprland Lua.",
                ICON_WARN,
            )
        else:
            store["hyprlandHook"] = "unsafe-config"
            notify(
                "Homing",
                f"{paths.hyprland_lua} is not a regular file; add {HYPRLAND_HOOK_CALL} yourself.",
                ICON_WARN,
            )
        return store
    if hyprland_has_hook(current):
        store["hyprlandHook"] = "installed"
        return store
    if not force and store.get("hyprlandHook") == "declined":
        return store
    choice = menu_select(
        "Allow Homing to add one line to ~/.config/hypr/hyprland.lua?",
        [
            f"{ICON_OK}\tYes, add {HYPRLAND_HOOK_CALL}\tyes",
            f"{ICON_EDIT}\tNo, I'll add that line myself\tno",
        ],
    )
    if choice == "yes":
        ensure_hyprland_hook(paths.hyprland_lua)
        store["hyprlandHook"] = "installed"
        return store
    if choice == "no":
        store["hyprlandHook"] = "declined"
    notify(
        "Homing",
        f'Assignment saved. Add {HYPRLAND_HOOK_CALL} to ~/.config/hypr/hyprland.lua so rules apply.',
        ICON_WARN,
    )
    return store


def generated_paths(paths: Paths) -> list[Path]:
    return [
        paths.lua,
        paths.lua.with_suffix(paths.lua.suffix + ".bak"),
        paths.assignments,
        paths.assignments.with_suffix(paths.assignments.suffix + ".bak"),
    ]


def uninstall_files(paths: Paths) -> list[str]:
    changed: list[str] = []
    original = read_regular_file(paths.hyprland_lua, max_bytes=MAX_TEXT_FILE_BYTES)
    if original is not None:
        updated = remove_hyprland_hook(original)
        if updated != original:
            backup_hyprland_hook(paths.hyprland_lua)
            atomic_write(paths.hyprland_lua, updated)
            changed.append(str(paths.hyprland_lua))
    for path in generated_paths(paths):
        if unlink_regular(path):
            changed.append(str(path))
    parent = paths.assignments.parent
    if rmdir_if_empty(parent):
        changed.append(str(parent))
    return changed


def hyprctl_json(args: list[str]) -> Any:
    result = run_limited(["hyprctl", *args, "-j"], timeout=HYPRCTL_TIMEOUT)
    if result is None or result.returncode != 0 or not result.stdout.strip():
        return None
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return None


def active_window() -> Window | None:
    data = hyprctl_json(["activewindow"])
    if not isinstance(data, dict):
        return None
    address = str(data.get("address") or "")
    class_name = str(data.get("class") or data.get("initialClass") or "")
    title = str(data.get("title") or "")
    if not class_name or address in {"", "0x0", "0x00"}:
        return None
    workspace = data.get("workspace") or {}
    workspace_name = str(workspace.get("name") or workspace.get("id") or "")
    pid = data.get("pid")
    return Window(
        address=address,
        class_name=class_name,
        initial_class=str(data.get("initialClass") or class_name),
        title=title,
        pid=int(pid) if isinstance(pid, int) and pid > 0 else None,
        workspace=workspace_name,
    )


def list_workspace_names() -> list[str]:
    names = [str(n) for n in NUMERIC_WORKSPACES]
    data = hyprctl_json(["workspaces"])
    if isinstance(data, list):
        for item in data:
            if not isinstance(item, dict):
                continue
            name = str(item.get("name") or item.get("id") or "")
            if name and name not in names:
                names.append(name)
    return names


def menu_select(prompt: str, rows: list[str], width: int = 420) -> str | None:
    result = run_limited(
        ["omarchy-menu-select", prompt, "--", "--width", str(width)],
        timeout=MENU_TIMEOUT,
        input_text="\n".join(rows) + "\n",
    )
    if result is None or result.returncode != 0:
        return None
    selection = result.stdout.strip()
    if not selection:
        return None
    if "\t" in selection:
        return selection.split("\t")[-1]
    return selection


def menu_input(prompt: str, width: int = 420) -> str | None:
    result = run_limited(
        ["omarchy-menu-input", prompt, "--width", str(width)],
        timeout=MENU_TIMEOUT,
    )
    if result is None or result.returncode != 0:
        return None
    value = result.stdout.strip()
    return value or None


def notify(headline: str, description: str = "", glyph: str = ICON_HOME) -> None:
    args = ["omarchy-notification-send", "-g", glyph, headline]
    if description:
        args.append(description)
    run_limited(args, timeout=NOTIFY_TIMEOUT)


def window_label(window: Window, profile: BrowserProfile | None = None) -> str:
    family = family_for_class(window.class_name)
    if profile and family:
        return f"{family.label} ({profile.name})"
    if family:
        return family.label
    return window.class_name


def build_class_assignment(window: Window, workspace: str) -> dict[str, Any]:
    return {
        "id": assignment_id("class", window.class_name),
        "kind": "class",
        "class": window.class_name,
        "class_regex": class_regex_for(window.class_name),
        "workspace": workspace,
        "label": window_label(window),
    }


def build_profile_assignment(window: Window, profile: BrowserProfile, workspace: str) -> dict[str, Any]:
    return {
        "id": assignment_id("profile", window.class_name, profile.directory),
        "kind": "profile",
        "class": window.class_name,
        "class_regex": class_regex_for(window.class_name),
        "profile_directory": profile.directory,
        "profile_name": profile.name,
        "user_data_dir": str(profile.user_data_dir),
        "tag": tag_for_profile(window.class_name, profile.directory),
        "workspace": workspace,
        "label": window_label(window, profile),
    }


def validate_workspace(value: str) -> str | None:
    text = value.strip()
    if not text:
        return None
    if text.isdigit():
        number = int(text)
        if number < 1:
            return None
        return str(number)
    if WORKSPACE_RE.match(text):
        return text
    return None


def choose_workspace(window: Window, current_assignment: dict[str, Any] | None) -> str | None:
    assigned = str(current_assignment.get("workspace")) if current_assignment else ""
    rows: list[str] = []
    for name in list_workspace_names():
        notes: list[str] = []
        if name == window.workspace:
            notes.append("here now")
        if assigned and name == assigned:
            notes.append("already homed")
        icon = ICON_OK if notes else ICON_HOME
        suffix = f" · {' · '.join(notes)}" if notes else ""
        rows.append(f"{icon}\tWorkspace {name}{suffix}\t{name}")
    rows.append(f"{ICON_EDIT}\tCustom workspace…\tcustom")
    if current_assignment:
        rows.append(f"{ICON_STOP}\tStop homing this app\tunpin")
    prompt = f"Home {window_label(window)}"
    if assigned:
        prompt += f" · workspace {assigned}"
    choice = menu_select(prompt, rows)
    if choice is None:
        return None
    if choice == "custom":
        typed = menu_input("Workspace number or name")
        if typed is None:
            return None
        workspace = validate_workspace(typed)
        if workspace is None:
            notify("Homing", f"Not a valid workspace: {typed}", ICON_WARN)
            return None
        return workspace
    return choice


def move_window(workspace: str) -> None:
    script = f'hl.dispatch(hl.dsp.window.move({{ workspace = {lua_string(workspace)} }}))'
    run_limited(["hyprctl", "dispatch", script], timeout=HYPRCTL_TIMEOUT)


def reload_hyprland() -> str:
    run_limited(["hyprctl", "reload"], timeout=HYPRCTL_RELOAD_TIMEOUT)
    errors = run_limited(["hyprctl", "configerrors"], timeout=HYPRCTL_TIMEOUT)
    if errors is None:
        return ""
    return (errors.stdout or "").strip()


def persist(paths: Paths, store: dict[str, Any]) -> str:
    save_store(paths.assignments, store)
    write_lua(paths, store)
    return reload_hyprland()


def cmd_pin(paths: Paths) -> int:
    window = active_window()
    if window is None:
        menu_select("No window focused", [f"{ICON_WARN}\tFocus an app window, then run Homing again\tok"])
        notify("Homing", "No active window to home", ICON_WARN)
        return 1

    store = load_store(paths.assignments)
    profile = detect_browser_profile(window) if family_for_class(window.class_name) else None
    kind = "class"
    if profile:
        choice = menu_select(
            f"Home {window_label(window, profile)}",
            [
                f"{ICON_BROWSER}\tAll {family_for_class(window.class_name).label} windows\tclass",
                f"{ICON_PROFILE}\tOnly the {profile.name} profile\tprofile",
            ],
        )
        if choice is None:
            return 0
        kind = choice

    target_profile = profile if kind == "profile" else None
    current = find_assignment(store, window, target_profile)
    workspace = choose_workspace(window, current)
    if workspace is None:
        return 0
    if workspace == "unpin":
        return cmd_unpin(paths, window=window, profile=target_profile, confirm=False)

    if target_profile:
        assignment = build_profile_assignment(window, target_profile, workspace)
    else:
        assignment = build_class_assignment(window, workspace)
    upsert_assignment(store, assignment)
    store = maybe_install_hyprland_hook(paths, store)
    errors = persist(paths, store)
    move_window(workspace)
    label = assignment["label"]
    if errors:
        notify("Homing saved, Hyprland reported errors", errors, ICON_WARN)
    else:
        notify("Homing", f"{label} will open on workspace {workspace}")
    return 0


def cmd_unpin(paths: Paths, window: Window | None = None, profile: BrowserProfile | None = None, confirm: bool = True) -> int:
    store = load_store(paths.assignments)
    window = window or active_window()
    if window is None:
        rows = [f"{ICON_STOP}\t{row.get('label') or row.get('id')} · workspace {row.get('workspace')}\t{row.get('id')}" for row in store.get("assignments", [])]
        if not rows:
            notify("Homing", "Nothing is homed yet")
            return 0
        choice = menu_select("Stop homing", rows)
        if not choice:
            return 0
        remove_assignment(store, choice)
        errors = persist(paths, store)
        notify("Homing", "Assignment removed" + (f" ({errors})" if errors else ""), ICON_STOP)
        return 0

    if profile is None and family_for_class(window.class_name):
        profile = detect_browser_profile(window)
    current = find_assignment(store, window, profile)
    if current is None:
        notify("Homing", f"{window_label(window, profile)} is not homed")
        return 0
    if confirm:
        choice = menu_select(
            f"Stop homing {current.get('label') or window.class_name}?",
            [
                f"{ICON_STOP}\tRemove workspace {current.get('workspace')} assignment\tyes",
                f"{ICON_APP}\tKeep it\tno",
            ],
        )
        if choice != "yes":
            return 0
    remove_assignment(store, str(current["id"]))
    errors = persist(paths, store)
    notify("Homing", f"{current.get('label') or window.class_name} no longer has a home" + (f" ({errors})" if errors else ""), ICON_STOP)
    return 0


def cmd_list(paths: Paths) -> int:
    store = load_store(paths.assignments)
    rows = store.get("assignments") or []
    if not rows:
        print("No homed apps.")
        return 0
    for row in rows:
        kind = row.get("kind")
        extra = ""
        if kind == "profile":
            extra = f" profile {row.get('profile_name') or row.get('profile_directory')}"
        print(f"{row.get('workspace'):<8} {row.get('label') or row.get('class')}{extra}  [{row.get('id')}]")
    return 0


def cmd_status(paths: Paths) -> int:
    window = active_window()
    if window is None:
        print("No active window.")
        return 1
    store = load_store(paths.assignments)
    profile = detect_browser_profile(window) if family_for_class(window.class_name) else None
    current = find_assignment(store, window, profile)
    print(f"class: {window.class_name}")
    if window.initial_class != window.class_name:
        print(f"initialClass: {window.initial_class}")
    print(f"workspace: {window.workspace}")
    if profile:
        print(f"profile: {profile.name} ({profile.directory})")
    if current:
        print(f"homed: workspace {current.get('workspace')} ({current.get('id')})")
    else:
        print("homed: no")
    return 0


def cmd_reload(paths: Paths) -> int:
    store = load_store(paths.assignments)
    write_lua(paths, store)
    errors = reload_hyprland()
    if errors:
        print(errors, file=sys.stderr)
        return 1
    print(f"Wrote {paths.lua}")
    return 0


def cmd_hook(paths: Paths) -> int:
    store = load_store(paths.assignments)
    current = read_regular_file(paths.hyprland_lua, max_bytes=MAX_TEXT_FILE_BYTES)
    if current is not None and hyprland_has_hook(current):
        store["hyprlandHook"] = "installed"
        save_store(paths.assignments, store)
        notify("Homing", "Hyprland already loads homing.lua")
        print(f"Hook already present in {paths.hyprland_lua}")
        return 0
    store = maybe_install_hyprland_hook(paths, store, force=True)
    save_store(paths.assignments, store)
    if store.get("hyprlandHook") == "installed":
        errors = reload_hyprland()
        if errors:
            print(errors, file=sys.stderr)
            return 1
        print(f"Added hook to {paths.hyprland_lua}")
        return 0
    print('No hook written. Add pcall(require, "hypr.homing") to ~/.config/hypr/hyprland.lua yourself.')
    return 0


def cmd_uninstall(paths: Paths) -> int:
    store = load_store(paths.assignments)
    count = len(store.get("assignments") or [])
    extra = f" and {count} assignment(s)" if count else ""
    choice = menu_select(
        "Remove Homing's generated files and Hyprland hook?",
        [
            f"{ICON_STOP}\tYes, remove generated files{extra} and the hyprland.lua hook\tyes",
            f"{ICON_APP}\tKeep everything\tno",
        ],
    )
    if choice != "yes":
        return 0
    changed = uninstall_files(paths)
    if changed:
        reload_hyprland()
    notify(
        "Homing",
        "Generated files removed. Then run: omarchy plugin remove reinier.homing",
        ICON_STOP,
    )
    if changed:
        print("Removed:")
        for path in changed:
            print(f"  {path}")
    else:
        print("Nothing to remove.")
    print("Disable the plugin with: omarchy plugin remove reinier.homing")
    return 0


def usage() -> str:
    return """Usage: homing [command]

Home the focused app so it always opens on the same Hyprland workspace.

Commands:
  pin        Home the focused window (default)
  unpin      Remove an assignment
  list       Print saved assignments
  status     Show the focused window's identity and assignment
  reload     Rewrite ~/.config/hypr/homing.lua and reload Hyprland
  hook       Ask to add the one-line hyprland.lua loader
  uninstall  Remove generated files and the hyprland.lua hook (asks first)
"""


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if args and args[0] in {"-h", "--help", "help"}:
        print(usage(), end="")
        return 0
    command = args[0] if args else "pin"
    paths = Paths.from_home()
    if command == "pin":
        return cmd_pin(paths)
    if command == "unpin":
        return cmd_unpin(paths)
    if command == "list":
        return cmd_list(paths)
    if command == "status":
        return cmd_status(paths)
    if command == "reload":
        return cmd_reload(paths)
    if command == "hook":
        return cmd_hook(paths)
    if command == "uninstall":
        return cmd_uninstall(paths)
    print(usage(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
